# Optional settings. Copy to .env.local and adjust. Leave empty for the defaults.

# Base URL of a server-side RDKit API for structure drawing/validation. Empty = in-browser RDKit.js.
VITE_CHEMISTRY_API_URL=
# Optional URL of a compound-list JSON for the lab shelves (default: the built-in reference compounds).
VITE_COMPOUND_LIBRARY_URL=
