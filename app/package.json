{
  "name": "toxilab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "postinstall": "node scripts/copy-rdkit.mjs",
    "python:setup": "python3 -m venv .venv && .venv/bin/pip install -r backend/requirements.txt",
    "python:test": ".venv/bin/python -m pytest backend/tests -q",
    "models:export": ".venv/bin/python backend/export_for_browser.py && vite-node scripts/build-known-molecules.ts",
    "models:verify": ".venv/bin/python backend/verify_models.py",
    "site:zip": "npm run build && rm -f toxilab-site.zip && cd dist && zip -qr ../toxilab-site.zip ."
  },
  "dependencies": {
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "@react-three/drei": "9.121.5",
    "@react-three/fiber": "8.17.14",
    "@react-three/postprocessing": "2.16.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
